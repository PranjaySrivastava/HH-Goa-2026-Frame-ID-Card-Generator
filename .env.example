# Vercel Blob read/write token — create a Blob store in the Vercel
# dashboard (Storage tab) and it's auto-injected in Production/Preview;
# for local dev with `vercel dev`, copy it here.
BLOB_READ_WRITE_TOKEN=

# Shared secret the cleanup cron sends as `Authorization: Bearer <value>`.
# Vercel Cron sets this automatically when the project has a CRON_SECRET
# env var configured — generate any random string and set it in both places.
CRON_SECRET=
